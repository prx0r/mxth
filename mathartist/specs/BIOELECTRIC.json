{
  "id": "BIOELECTRIC",
  "short": "BIO",
  "title": "Manicka\u2013Levin bioelectric field morphogenesis",
  "description": "Equation-level deterministic reimplementation of the cellular field network documented in Manicka & Levin (2025): voltage-gated ion channels, voltage-gated gap junctions, Coulomb-like extracellular field and field-to-channel feedback. The trained clamp pickle is not bundled; roots use fixed initial conditions explicitly demonstrated in the authors' repository.",
  "provenance_level": "EXACT-EQUATIONS",
  "core_statement": "bioelectric equations, physical parameters and initial condition are frozen per lineage; only observation evolves",
  "upstream": "https://github.com/santamanicka/ElectricMorphogenesis",
  "paper": "Field-mediated bioelectric basis of morphogenetic prepatterning (Manicka & Levin, 2025)",
  "immutable_core": {
    "lattice": "11x11 non-periodic cellular lattice",
    "ion_channels": "voltage-gated hyperpolarizing/depolarizing currents",
    "gap_junction": "G_res + 2 G_0/(1+cosh((Vi-Vj)/V0))",
    "field": "Coulomb-like extracellular field from Q=C*Vmem with documented screening",
    "field_feedback": "documented sigmoid field transduction into G_pol",
    "dt": 0.01,
    "GJStrength": 0.05,
    "fieldScreenSize": 4
  },
  "source_variants": [
