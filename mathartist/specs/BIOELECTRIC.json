      "id": "center-hyperpolarized",
      "label": "single hyperpolarized center cell"
    },
    {
      "id": "french-flag",
      "label": "three-band Vmem initial condition"
    },
    {
      "id": "uniform-bistable",
      "label": "uniform -9.2mV baseline"
    }
  ],
